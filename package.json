{
  "name": "artist-os",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @artist-os/web --filter @artist-os/worker dev",
    "dev:web": "pnpm --filter @artist-os/web dev",
    "dev:worker": "pnpm --filter @artist-os/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @artist-os/db test:integration",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "arch:check": "node scripts/check-architecture.mjs",
    "auth:generate": "auth generate --config apps/web/lib/auth.ts --output packages/db/generated/better-auth.sql --yes",
    "db:generate": "pnpm --filter @artist-os/db db:generate",
    "db:migrate": "pnpm --filter @artist-os/db db:migrate",
    "demo:seed": "pnpm --filter @artist-os/db demo:seed"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "auth": "1.7.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
